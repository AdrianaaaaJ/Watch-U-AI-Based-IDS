APP_ENV=local
APP_NAME="Watch-U"
APP_URL=http://watch-u.test
APP_TIMEZONE=Asia/Kuala_Lumpur
SESSION_NAME=WATCHUSESSID
SESSION_PATH=data/sessions
DB_PATH=database/watchu.sqlite
PYTHON_BINARY=python

# Keep secrets here. Never commit a real .env file.
TELEGRAM_BOT_TOKEN=
WATCHU_AI_SUMMARY_URL=
WATCHU_AI_API_KEY=

# Wazuh API credentials are used only by the PHP backend.
WAZUH_URL=https://your-wazuh-manager.example:55000
WAZUH_USERNAME=
WAZUH_PASSWORD=
# Absolute path to a trusted CA PEM file when using a private CA.
WAZUH_CA_BUNDLE=

# Live alerts over SSH/SFTP. Use a read-only Linux account on the VM.
WAZUH_SSH_HOST=
WAZUH_SSH_PORT=22
WAZUH_SSH_USERNAME=
WAZUH_SSH_PRIVATE_KEY=
WAZUH_SSH_PASSWORD=
WAZUH_SSH_KEY_PASSPHRASE=
WAZUH_SSH_KNOWN_HOSTS=
WAZUH_ALERTS_PATH=/var/ossec/logs/alerts/alerts.json
WAZUH_POLL_SECONDS=3

# Nmap is off until an administrator explicitly enables it.
ENABLE_NMAP_SCANS=false
NMAP_BINARY=nmap
